# CutSync — AI Music Generation Studio Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# AI Music Generation Providers (Optional)
# If left blank, CutSync seamlessly runs on the built-in local DSP & Neural Engine (Zero Cost, 48 kHz Stereo)
REPLICATE_API_TOKEN=""

# Gemini API Key (Optional, for advanced semantic prompt understanding)
GEMINI_API_KEY=""

# Webhook Callback Secret (Optional, for HMAC-SHA256 event signing)
CUTSYNC_WEBHOOK_SECRET="cutsync-studio-secret-key"
